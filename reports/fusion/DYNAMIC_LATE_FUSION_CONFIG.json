  "confidence_definitions": {
    "margin_confidence": "min(1.0, 2.0 * abs(prob - 0.50))",
    "video_reliability": "valid_frame_pct/100.0 * mean_pose_conf * (1.0 - 0.5 * amb_pct/100.0)",
    "audio_reliability": "clip((energy_db - (-50.0 dBFS)) / 35.0, 0.1, 1.0) when (audio_present and energy_db > -50.0 dBFS) else 0.0",
    "effective_video_confidence": "Cv_eff = video_confidence * video_reliability",
    "effective_audio_confidence": "Ca_eff = audio_confidence * audio_reliability"
  },
  "weight_calculation": {
    "formula_video": "Wv = Cv_eff / (Cv_eff + Ca_eff)",
    "formula_audio": "Wa = Ca_eff / (Cv_eff + Ca_eff)",
    "constraint": "Wv + Wa == 1.0, Wv in [0.0, 1.0], Wa in [0.0, 1.0]",
    "zero_confidence_fallback": {
      "video_only_present": "Wv = 1.0, Wa = 0.0",
      "audio_only_present": "Wv = 0.0, Wa = 1.0",
      "both_or_neither_present": "Wv = 0.50, Wa = 0.50"
    }
  },
  "temporal_alignment": {
    "grid_tick_seconds": 0.5,
    "grid_tick_hz": 2.0,
    "time_origin": "t=0 at first video frame / audio sample",
    "overlap_rule": "Windows overlapping tick [t0, t1] (start < t1 and end > t0) are aggregated via arithmetic mean"
  },
  "aggregation": {
    "segment_level_fusion": "R1_segment = Wv_seg * Pv_seg + Wa_seg * Pa_seg",
    "clip_level_fusion": "R1_clip = Wv_clip * Pv_clip + Wa_clip * Pa_clip",
    "score_scaling": "Multimodal Behavioral Risk Score = round(R1 * 100)"
  },
  "risk_thresholds": {
